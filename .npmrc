# apps/mobile intentionally pins React 18 (required by React Native 0.76)
# while apps/web pins React 19 (required by Next.js 15) — see the "Known
# gotcha: React version pinning" section of README.md. npm's default
# strict peer-dependency resolution treats that as an unresolvable
# conflict; legacy-peer-deps lets npm nest each app's own copy instead,
# which is what we actually want here.
legacy-peer-deps=true
