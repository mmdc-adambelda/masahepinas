# Masahe Pinas — Environment Variables (example / no real secrets)
# This file documents variables anticipated by the Phase 0 architecture.
# It will be expanded/adjusted as each phase is implemented.
# Never commit a real .env file. Copy this to .env.local (web) / .env (mobile)
# and fill in real values from your own Supabase/project dashboards.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or bundle into the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Maps / Geocoding (provider TBD — abstracted behind MapProvider) ---
NEXT_PUBLIC_MAP_TILE_URL=
MAP_GEOCODING_PROVIDER_API_KEY=

# --- Billing (test-mode provider for early development) ---
BILLING_PROVIDER=test_mode
BILLING_WEBHOOK_SIGNING_SECRET=

# --- Email (verification, notifications) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@masahepinas.example

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=
